# Copy to .env before running `docker compose up -d --build`.

# Host ports published by Compose (internal ports stay 3001 / 3000 / 80).
BACKEND_PORT=3001
FRONTEND_PORT=3000
REACT_PORT=5173

# Comma-separated list of browser origins allowed to call the API with cookies.
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Image names used by `docker compose pull` on a deployed host.
IMAGE_OWNER=harrysuke
IMAGE_TAG=latest
